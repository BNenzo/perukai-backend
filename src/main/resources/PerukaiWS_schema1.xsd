      <xs:element name="ActualizarReservaClienteRequest" type="tns:actualizarReservaClienteRequestBean" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="actualizarReservaClienteRequestBean">
    <xs:sequence>
